{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octopus",
  "identifier": "com.zabealbe.octopus",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "octopus",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
