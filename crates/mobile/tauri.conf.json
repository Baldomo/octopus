{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octopus",
  "identifier": "com.zabealbe.octopus",
  "build": {
    "frontendDist": "../../ui/mobile/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "octopus"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"],
    "iOS": {
      "minimumSystemVersion": "17.5"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
