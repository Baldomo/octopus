{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octopus",
  "identifier": "com.noi.octopus",
  "build": {
    "frontendDist": "../../ui/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "octopus",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost octopus-file:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: octopus-file:; media-src octopus-file:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.5",
      "infoPlist": "../cli/octopus.plist",
      "entitlements": "octopus.entitlements"
    }
  }
}
