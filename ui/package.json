{
  "name": "octopus-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "desktop",
    "mobile"
  ],
  "scripts": {
    "build": "bun run --cwd desktop build && bun run --cwd mobile build",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p desktop && tsc --noEmit -p mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --conditions=browser"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
