{
  "name": "octopus-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "desktop"
  ],
  "scripts": {
    "build": "npm --workspace desktop run build",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p desktop",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
